# Copy to backend/.env for local development.

# SQLite locally. A hosted deploy sets a postgresql:// URL instead, and the
# container entrypoint detects which one it is.
DATABASE_URL="file:./dev.db"

PORT=4000
# 127.0.0.1 keeps the API off the network. Use 0.0.0.0 in a container.
HOST=127.0.0.1

# Both must be set to enable the HTTP Basic auth gate. Left unset locally.
# BASIC_AUTH_USER=demo
# BASIC_AUTH_PASSWORD=change-me

# Overrides for the demo login shown on the sign-in page.
# DEMO_EMAIL=demo@user.com
# DEMO_PASSWORD=password
