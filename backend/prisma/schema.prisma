// Inventory demo schema. SQLite has no native enums, so enum-ish columns are
// Strings; the allowed values are listed above each field and enforced in the
// API layer (src/domain.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma will not accept env() here, so the provider is literal and the
  // deploy script rewrites this one line for Postgres (npm run schema:pg).
  // Nothing else in this schema is vendor-specific — no native enums, no
  // Decimal, no Json, and the app issues no raw SQL. Money is integer cents,
  // which both databases store exactly.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  sku         String  @unique
  name        String
  description String?
  barcode     String?
  category    String?
  categoryId  Int?
  brand       String?

  /// Money is in integer cents throughout.
  defaultCostCents  Int @default(0)
  defaultPriceCents Int @default(0)

  length Float?
  width  Float?
  height Float?
  weight Float?

  /// NONE or SERIAL. Deliberately NOT a `LOT` mode: `InventoryLot` already exists
  /// for EVERY product as the FIFO cost layer, so a tracking mode named LOT would
  /// read as "this product uses InventoryLot" when all modes do. A batch/expiry
  /// mode is a real third thing — add it when something names the requirement.
  ///
  /// SERIAL changes how stock is RECEIVED, not how it is valued: a serialized
  /// product gets one cost layer PER UNIT (`originalQty: 1`) with a SerialUnit
  /// pointing at it, so "active serials == on-hand qty" is true by construction
  /// rather than by a reconciliation job comparing two counters.
  trackingMode String @default("NONE")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serialUnits        SerialUnit[]
  vendorAliases      VendorProductAlias[]
  productCategory    ProductCategory?    @relation(fields: [categoryId], references: [id])
  lots               InventoryLot[]
  balances           InventoryBalance[]
  movements          InventoryMovement[]
  salesOrderLines    SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  adjustments        StockAdjustment[]
  transfers          StockTransfer[]

  @@index([name])
  stockCountLines StockCountLine[]
  repairPartLines RepairPartLine[]
  shopifyLink ShopifyLink?
}

model Warehouse {
  id      Int     @id @default(autoincrement())
  name    String
  code    String  @unique
  address String?
  notes   String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances           InventoryBalance[]
  movementsFrom      InventoryMovement[] @relation("MovementFrom")
  movementsTo        InventoryMovement[] @relation("MovementTo")
  salesOrderLines    SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  adjustments        StockAdjustment[]
  transfersFrom      StockTransfer[]     @relation("TransferFrom")
  transfersTo        StockTransfer[]     @relation("TransferTo")
  lots               InventoryLot[]
  shipments          Shipment[]
  goodsReceipts      GoodsReceipt[]
  stockCounts     StockCount[]
  serialUnits SerialUnit[]
  repairPartLines RepairPartLine[]
  shopifyLocation ShopifyLocation?
}

/// Current stock for a [product, warehouse] pair.
/// availableQty is derived (onHandQty - reservedQty) and computed in the API.
model InventoryBalance {
  id            Int      @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  onHandQty     Int      @default(0)
  reservedQty   Int      @default(0)
  incomingQty   Int      @default(0)
  reorderPoint  Int      @default(0)
  lastUpdatedAt DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

/// Immutable audit trail. movementType is one of:
/// ADJUSTMENT_IN | ADJUSTMENT_OUT | TRANSFER_OUT | TRANSFER_IN | SALE_SHIP | PURCHASE_RECEIPT
model InventoryMovement {
  id              Int      @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int?
  toWarehouseId   Int?
  quantity        Int
  movementType    String
  reason          String?
  referenceType   String?
  referenceId     Int?
  /// Cost of the goods that moved, from the FIFO layers they came out of.
  /// Zero where a movement carries no cost.
  totalCostCents  Int      @default(0)
  actor           String   @default("demo@user.com")
  createdAt       DateTime @default(now())

  // Restrict, not Cascade: the audit trail must outlive a careless product
  // delete. The API soft-deletes any product that has movements.
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse?       @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?       @relation("MovementTo", fields: [toWarehouseId], references: [id])
  lotConsumptions LotConsumption[]

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// status: DRAFT | CONFIRMED | SHIPPED | CANCELED
/// The scope gives sales orders TWO independent axes, not one status:
///   readinessStatus: NOT_PACKED | PACKED | SHIPPED | CANCELED
///   paymentStatus:   AWAITING_PAYMENT | INVOICED | PAID | VOIDED
/// `channel` records where the order came from (DIRECT, SHOPIFY, ...).
model SalesOrder {
  /// Single currency today. Recorded per document anyway, so adding a second
  /// one later is an addition rather than a rewrite of every money path.
  currency        String   @default("USD")
  id              Int      @id @default(autoincrement())
  orderNumber     String   @unique
  customerId      Int?
  customerName    String
  employeeId      Int?
  readinessStatus String   @default("NOT_PACKED")
  paymentStatus   String   @default("AWAITING_PAYMENT")
  channel         String   @default("DIRECT")
  notes           String?
  subtotalCents   Int      @default(0)
  taxCents        Int      @default(0)
  shippingCents   Int      @default(0)
  totalCents      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer  Customer?        @relation(fields: [customerId], references: [id])
  employee  Employee?        @relation(fields: [employeeId], references: [id])
  lines     SalesOrderLine[]
  invoices  Invoice[]
  shipments Shipment[]
  deposits  Payment[]
}

/// status: PENDING | RESERVED | SHIPPED | CANCELED
model SalesOrderLine {
  /// How much of this line has actually left. Partial shipment and backorder
  /// are ordinary; an order is not a single all-or-nothing event.
  shippedQty      Int      @default(0)
  id             Int    @id @default(autoincrement())
  salesOrderId   Int
  productId      Int
  warehouseId    Int
  quantity       Int
  unitPriceCents Int    @default(0)
  lineTotalCents Int    @default(0)
  status         String @default("PENDING")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
}

/// status: DRAFT | ORDERED | RECEIVED | CANCELED
/// The scope's purchase order lifecycle is SAVED -> POSTED -> PAID ->
/// DELIVERED, each step posting its own journal entry. `status` carries the
/// furthest step reached; CANCELED ends it.
model PurchaseOrder {
  /// Single currency today. Recorded per document anyway, so adding a second
  /// one later is an addition rather than a rewrite of every money path.
  currency        String   @default("USD")
  id            Int      @id @default(autoincrement())
  poNumber      String   @unique
  vendorId      Int?
  supplierName  String
  employeeId    Int?
  status        String   @default("SAVED")
  notes         String?
  subtotalCents Int      @default(0)
  taxCents      Int      @default(0)
  shippingCents Int      @default(0)
  totalCents    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  employee      Employee?           @relation(fields: [employeeId], references: [id])
  lines         PurchaseOrderLine[]
  bills         Bill[]
  goodsReceipts GoodsReceipt[]
}

/// status: PENDING | ORDERED | RECEIVED | CANCELED
model PurchaseOrderLine {
  /// How much of this line has actually arrived. Suppliers under-ship; a system
  /// that cannot record it makes staff lie to it.
  receivedQty     Int      @default(0)
  id              Int    @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  warehouseId     Int
  quantity        Int
  unitCostCents   Int    @default(0)
  lineTotalCents  Int    @default(0)
  status          String @default("PENDING")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
}

/// adjustmentType: INCREASE | DECREASE
/// A physical count, as a session rather than a pile of adjustments.
///
/// Counting is event-shaped: you freeze what the system believes, walk the
/// aisles, record what is actually there, then post the difference ONCE. Doing
/// it as individual adjustments loses the fact that they were one count, posts
/// a journal entry per SKU, and gives no answer to "what did we find on the
/// 30th".
model StockCount {
  id          Int      @id @default(autoincrement())
  countNumber String   @unique
  warehouseId Int
  /// DRAFT while lines are being counted, POSTED once the variance is booked,
  /// CANCELED if abandoned. A posted count is immutable.
  status      String   @default("DRAFT")
  notes       String?
  countedAt   DateTime @default(now())
  postedAt    DateTime?
  actor       String   @default("system")
  createdAt   DateTime @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]
}

model StockCountLine {
  id           Int  @id @default(autoincrement())
  stockCountId Int
  productId    Int
  /// What the system believed when the count was opened. Frozen at that moment
  /// on purpose: the variance must be against what was expected when counting
  /// began, not against a number that moved while someone walked the aisle.
  expectedQty  Int
  /// Null until somebody actually counts it. Null is NOT zero — "not counted"
  /// and "counted, none there" are different findings and only one is a
  /// variance.
  countedQty   Int?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
}

model StockAdjustment {
  id             Int      @id @default(autoincrement())
  productId      Int
  warehouseId    Int
  adjustmentType String
  quantity       Int
  reason         String
  actor          String   @default("demo@user.com")
  createdAt      DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([createdAt])
}

/// status: DRAFT | IN_TRANSIT | COMPLETED | CANCELED
model StockTransfer {
  id              Int      @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int
  toWarehouseId   Int
  quantity        Int
  /// Carrying cost of the goods in transit, set when the transfer starts.
  costCents       Int      @default(0)
  status          String   @default("DRAFT")
  notes           String?
  actor           String   @default("demo@user.com")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product   @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CATALOGS (master data)
// ---------------------------------------------------------------------------

/// Two-level tree only: a category with a parent may not itself be a parent.
/// Enforced in the API, since SQLite cannot express it.
model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String
  parentId Int?
  isActive Boolean @default(true)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([name, parentId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  repairOrders RepairOrder[]
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  bills          Bill[]
  payments       Payment[]
  productAliases VendorProductAlias[]
}

/// "Employees (Managers)" in the scope — Sales reports filter by this.
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  role      String   @default("MANAGER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

// ---------------------------------------------------------------------------
// DOUBLE-ENTRY LEDGER
//
// Money is stored as INTEGER MINOR UNITS (cents) everywhere. Floats cannot
// represent money exactly and a ledger that does not balance to the cent is
// worthless.
// ---------------------------------------------------------------------------

/// accountType: ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
/// Single-row ledger configuration. A key/value table rather than columns on a
/// settings model, so a new control does not need a migration.
/// One row per document type, holding the last number issued.
///
/// Numbers used to come from max(id), read and incremented inside the
/// transaction with no lock. Under Postgres READ COMMITTED two concurrent
/// creates read the same maximum and mint the same number; the unique index
/// caught it, but the loser got "a record with that unique value already
/// exists" for a request that was perfectly legitimate. SQLite serialises
/// writers, so this could never reproduce in local development.
model DocumentCounter {
  kind      String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A person who can sign in.
///
/// Roles are coarse on purpose: the useful split in a warehouse is between the
/// people who MOVE STOCK and the people who POST MONEY, and a finer grid would
/// be configuration nobody maintains. ADMIN additionally manages users.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  /// scrypt, salted per user. Format: scrypt$N$r$p$salt$hash, all base64.
  passwordHash String
  role         String   @default("VIEWER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

model LedgerSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Account {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  accountType String
  /// DEBIT or CREDIT — the side that increases this account.
  normalSide  String
  isActive    Boolean @default(true)

  lines JournalLine[]
}

/// A financial transaction. status: SAVED | POSTED | VOID
/// Only POSTED entries affect the ledger. A SAVED entry may be edited or
/// deleted; a POSTED one may only be unposted, and only when nothing depends
/// on it.
model JournalEntry {
  id              Int       @id @default(autoincrement())
  entryNumber     String    @unique
  transactionType String
  entryDate       DateTime  @default(now())
  memo            String?
  status          String    @default("SAVED")
  postedAt        DateTime?
  /// Set true the first time this entry is posted and never cleared. Unposting
  /// clears `postedAt`, so without this an entry could be posted, unposted and
  /// then deleted — erasing history the ledger promises to keep.
  hasBeenPosted   Boolean   @default(false)
  referenceType   String?
  referenceId     Int?
  actor           String    @default("demo@user.com")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines JournalLine[]

  @@index([transactionType, entryDate])
  @@index([referenceType, referenceId])
}

/// One side of an entry. Exactly one of debitCents/creditCents is non-zero,
/// and the two sums must be equal across the entry.
model JournalLine {
  id             Int     @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  debitCents     Int     @default(0)
  creditCents    Int     @default(0)
  memo           String?
  /// Optional analytics so a report can slice the ledger without joins.
  productId      Int?
  warehouseId    Int?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([journalEntryId])
}

/// Maps a transaction type to the accounts it posts against, so the postings
/// are configuration rather than code. "Common Journal Entry Templates
/// corresponding to Financial Transaction Types" in the scope.
model JournalTemplate {
  id                Int    @id @default(autoincrement())
  transactionType   String @unique
  description       String
  debitAccountCode  String
  creditAccountCode String
}

// ---------------------------------------------------------------------------
// FIFO COST LAYERS
// ---------------------------------------------------------------------------

/// One receipt of stock at a known unit cost. FIFO consumes the oldest
/// remaining layer first. A quantity balance cannot answer "what did this
/// cost" — these rows can.
model InventoryLot {
  id            Int      @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  unitCostCents Int
  originalQty   Int
  remainingQty  Int
  receivedAt    DateTime @default(now())
  sourceType    String
  sourceId      Int?

  product      Product          @relation(fields: [productId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  consumptions LotConsumption[]
  /// At most one serial per layer — a serialized layer holds exactly one unit.
  serialUnit   SerialUnit?

  @@index([productId, warehouseId, receivedAt])
}

/// Which layers a given issue drew from, and at what cost. This is the audit
/// trail behind every COGS number.
model LotConsumption {
  id            Int      @id @default(autoincrement())
  lotId         Int
  quantity      Int
  unitCostCents Int
  movementId    Int?
  sourceType    String
  sourceId      Int?
  createdAt     DateTime @default(now())

  lot      InventoryLot       @relation(fields: [lotId], references: [id])
  movement InventoryMovement? @relation(fields: [movementId], references: [id])

  @@index([lotId])
}

// ---------------------------------------------------------------------------
// FINANCIAL DOCUMENTS
//
// Each is a document in its own right that posts its own journal entry, rather
// than a side effect of an order transition.
// ---------------------------------------------------------------------------

/// status: SAVED | POSTED | VOID
model Invoice {
  /// Single currency today. Recorded per document anyway, so adding a second
  /// one later is an addition rather than a rewrite of every money path.
  currency        String   @default("USD")
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  salesOrderId  Int?
  customerId    Int
  issueDate     DateTime @default(now())
  /// When the customer owes it: issue date plus the channel's terms. Null on
  /// invoices raised before channels carried terms.
  dueDate       DateTime?
  subtotalCents Int      @default(0)
  taxCents      Int      @default(0)
  shippingCents Int      @default(0)
  totalCents    Int      @default(0)
  status        String   @default("SAVED")
  createdAt     DateTime @default(now())

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  payments   Payment[]
}

/// A vendor bill. status: SAVED | POSTED | VOID
model Bill {
  /// Single currency today. Recorded per document anyway, so adding a second
  /// one later is an addition rather than a rewrite of every money path.
  currency        String   @default("USD")
  id              Int      @id @default(autoincrement())
  billNumber      String   @unique
  purchaseOrderId Int?
  vendorId        Int
  issueDate       DateTime @default(now())
  subtotalCents   Int      @default(0)
  taxCents        Int      @default(0)
  shippingCents   Int      @default(0)
  totalCents      Int      @default(0)
  status          String   @default("SAVED")
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  payments      Payment[]
}

/// direction: RECEIPT (from a customer) | DISBURSEMENT (to a vendor)
/// status: SAVED | POSTED | VOID
model Payment {
  /// Single currency today. Recorded per document anyway, so adding a second
  /// one later is an addition rather than a rewrite of every money path.
  currency        String   @default("USD")
  id            Int      @id @default(autoincrement())
  paymentNumber String   @unique
  direction     String
  amountCents   Int
  method        String   @default("BANK")
  paidAt        DateTime @default(now())
  status        String   @default("SAVED")
  invoiceId     Int?
  billId        Int?
  customerId    Int?
  vendorId      Int?
  /// Set on a checkout payment taken before the order shipped. Until shipment
  /// raises the invoice, invoiceId is null and the money is a deposit; the
  /// invoice is attached when the deposit is applied.
  salesOrderId  Int?
  createdAt     DateTime @default(now())

  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  bill     Bill?     @relation(fields: [billId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
}

/// The outbound document. Posting it is what consumes FIFO layers and books COGS.
model Shipment {
  id             Int      @id @default(autoincrement())
  shipmentNumber String   @unique
  salesOrderId   Int
  /// Null when the order ships from more than one warehouse — the lines are
  /// the authority on where each item came from.
  warehouseId    Int?
  shippedAt      DateTime @default(now())
  /// Who carried it and the number the customer quotes. RECORDED, never
  /// fetched: Stockroom does not call a carrier API, buy labels or shop rates.
  /// Knowing which parcel left and how it can be found is warehouse record
  /// keeping; the rest is a shipping platform and a different product.
  carrier        String?
  trackingNumber String?
  /// Set when delivery is confirmed. Null means in transit as far as this
  /// system knows — which is all it can honestly claim without an integration.
  deliveredAt    DateTime?
  status         String   @default("SAVED")
  cogsCents      Int      @default(0)
  createdAt      DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse? @relation(fields: [warehouseId], references: [id])
}

/// Goods Receipt Note. Posting it creates the FIFO cost layers.
model GoodsReceipt {
  id              Int      @id @default(autoincrement())
  grnNumber       String   @unique
  purchaseOrderId Int
  /// Null when the receipt lands in more than one warehouse.
  warehouseId     Int?
  receivedAt      DateTime @default(now())
  status          String   @default("SAVED")
  totalCostCents  Int      @default(0)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id])
}

/// One physical unit, tracked by its serial number.
///
/// WHY THIS IS NOT A SECOND SOURCE OF TRUTH. A serial does not carry its own
/// quantity or its own on-hand flag. It points at ONE `InventoryLot` whose
/// `remainingQty` is 0 or 1, and that lot participates in the ordinary FIFO
/// machinery unchanged. So `InventoryBalance.onHandQty` is still
/// `sum(remainingQty)` across layers, and "in-stock serial count == on-hand
/// quantity" holds BY CONSTRUCTION. The alternative — a serial table with its
/// own status plus a join to movements — duplicates on-hand transitively and
/// needs every future code path to remember to write the join row.
///
/// `lotId` is nullable ON PURPOSE: a unit under repair for a customer is NOT
/// owned stock and must not sit in a cost layer. See `status`.
model SerialUnit {
  id           Int      @id @default(autoincrement())
  productId    Int
  /// As scanned. Unitree prints this on the carton AND on the chassis; the
  /// chassis marking is the durable one because boxes get thrown away and the
  /// unit comes back for RMA years later.
  serialNumber String
  /// Scanned off the carton at receiving, when it differs from the hardware
  /// serial. A mismatch is a finding to surface, never something to silently
  /// reconcile.
  boxSerial    String?
  /// Set when a lot exists: owned, valued stock. NULL while the unit is in
  /// custody for repair — a customer's broken printer on our shelf is not our
  /// asset, and booking it as inventory would debit Inventory for something we
  /// do not own.
  lotId        Int?     @unique
  /// IN_STOCK | SOLD | RECEIVED_FOR_REPAIR | IN_REPAIR | RETURNED_TO_CUSTOMER
  /// | REPLACED | SENT_TO_VENDOR | SCRAPPED
  status       String   @default("IN_STOCK")
  /// Where the unit physically is. For custody states this is a location, not a
  /// stock balance.
  warehouseId  Int?
  /// Warranty is DERIVED from this plus the policy's duration — never stored as
  /// a computed boolean or a fixed end date, for the same reason `availableQty`
  /// is always derived and `amountPaidCents` is recomputed: a stored answer
  /// drifts the moment terms change or time simply passes.
  warrantyStartAt DateTime?
  notes        String?

  /// HOW this serial got here. Everything auto-commits; provenance is what makes
  /// that safe to review later rather than something to gate on up front.
  /// BARCODE | OCR | OCR_CORROBORATED | MANUAL | IMPORTED
  serialSource  String  @default("MANUAL")
  /// OCR confidence as reported by the reader, 0-1. Null for non-OCR sources.
  ocrConfidence Float?
  /// Object key for the label photo. Kept because when a serial is disputed
  /// years later the picture settles it, and storage is cheap next to a lost
  /// warranty claim.
  labelImageKey String?
  /// Committed, but worth a human eye. NOT a block — the unit is already in
  /// stock and usable. A sweep clears these; nothing waits on it.
  needsReview   Boolean @default(false)
  reviewReason  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  corrections SerialCorrection[]
  product   Product       @relation(fields: [productId], references: [id])
  lot       InventoryLot? @relation(fields: [lotId], references: [id])
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])

  /// Serial numbers are only guaranteed unique WITHIN a manufacturer's range,
  /// so the key is (product, serial). `serialNumber` is indexed on its own
  /// because RMA intake scans a serial with no product context — that lookup
  /// may legitimately return more than one row, and the UI must say so rather
  /// than pick one.
  @@unique([productId, serialNumber])
  @@index([serialNumber])
  @@index([status, warehouseId])
  repairOrders RepairOrder[]
}

/// Warranty duration by brand or product. Terms only — NOT an adjudication
/// engine. Whether a specific claim is covered is a human judgement recorded on
/// the repair, not a rule this system evaluates.
model WarrantyPolicy {
  id             Int      @id @default(autoincrement())
  /// Matches `Product.brand` when productId is null; a product-specific policy
  /// wins over a brand one.
  brand          String?
  productId      Int?
  durationMonths Int
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([brand, productId])
}

/// What a vendor calls a product, mapped to what we call it.
///
/// WHY: BambuLab and XAG put SKUs on their purchase orders, so a receipt matches
/// a PO line directly. Unitree ships product NAMES and serials with no SKU, so
/// the only way to resolve a Unitree receipt to a product is by name. Once a
/// human maps a name here it is deterministic forever; assisted matching is only
/// for a name never seen before, and it proposes — it never creates.
model VendorProductAlias {
  id                Int      @id @default(autoincrement())
  vendorId          Int
  vendorProductName String
  productId         Int
  /// Who confirmed the mapping. A proposed match is not a mapping until a human
  /// accepts it.
  confirmedBy       String?
  createdAt         DateTime @default(now())

  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([vendorId, vendorProductName])
}

/// A unit taken in for service or repair.
///
/// 🔴 INTAKE IS NOT AN INVENTORY EVENT. A customer's unit on our bench is not
/// our asset — the `SerialUnit` it points at carries `lotId: null` for exactly
/// that reason. No balance moves and no journal entry is written when a repair
/// opens. Only two things here touch the ledger: parts consumed from our own
/// stock (Dr Repair Parts Expense) and a replacement unit given away
/// (Dr Warranty Expense). Both credit Inventory, neither touches COGS, because
/// there is no revenue matched against them.
model RepairOrder {
  id            Int      @id @default(autoincrement())
  repairNumber  String   @unique
  serialUnitId  Int
  customerId    Int?
  /// OPEN | IN_PROGRESS | AWAITING_PARTS | COMPLETED | RETURNED | REPLACED | SCRAPPED
  status        String   @default("OPEN")
  /// Whether the customer is charged. Derived warranty state INFORMS this, it
  /// does not decide it — coverage is a human judgement recorded here, not a
  /// rule the system evaluates.
  billable      Boolean  @default(true)
  /// Why it was judged in or out of warranty, in the words of whoever judged it.
  coverageNote  String?
  faultReported String?
  workDone      String?
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  actor         String

  serialUnit SerialUnit        @relation(fields: [serialUnitId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  parts      RepairPartLine[]

  @@index([status])
}

/// A part pulled from our own stock for a repair. Consuming it is an ordinary
/// inventory movement through the existing pipeline — applyBalanceDelta,
/// consumeFifo or consumeSerials, recordMovement, postSimple — it just posts to
/// Repair Parts Expense rather than COGS.
model RepairPartLine {
  id            Int      @id @default(autoincrement())
  repairOrderId Int
  productId     Int
  warehouseId   Int
  quantity      Int
  /// FIFO cost of the layers actually consumed, filled in at consumption time.
  totalCostCents Int     @default(0)
  /// Named units, when the part is itself serial-tracked.
  serialNumbers String?
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([repairOrderId])
}

/// Every change to a serial number, kept forever.
///
/// Auto-committed OCR is only safe because it is REVERSIBLE: the unit's identity
/// is its cost layer, not the string, so fixing a misread is an update rather
/// than a lost unit. This table is what makes the fix auditable — without it a
/// corrected serial is indistinguishable from one that was always right, and a
/// warranty dispute has nothing to look at.
model SerialCorrection {
  id           Int      @id @default(autoincrement())
  serialUnitId Int
  fromSerial   String
  toSerial     String
  reason       String?
  actor        String
  createdAt    DateTime @default(now())

  serialUnit SerialUnit @relation(fields: [serialUnitId], references: [id])

  @@index([serialUnitId])
}

/// Maps one of our products to its Shopify variant.
///
/// ProductVariant and InventoryItem are 1:1 in Shopify, so the inventory item
/// id is what quantity pushes actually address. Stored rather than looked up
/// each time because a push runs per product per warehouse and the mapping
/// almost never changes.
model ShopifyLink {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique
  variantId       String
  inventoryItemId String
  /// What we last told Shopify. This is the `compareQuantity` for the next
  /// push, which is how compare-and-set detects that someone sold in between.
  lastPushedQty   Int?
  lastPushedAt    DateTime?
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

/// Maps one of our warehouses to a Shopify location.
model ShopifyLocation {
  id          Int    @id @default(autoincrement())
  warehouseId Int    @unique
  locationId  String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

