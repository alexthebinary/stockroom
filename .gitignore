node_modules/
dist/
*.log

# Local database — never committed. The hosted instance uses Postgres.
backend/prisma/dev.db
backend/prisma/dev.db-journal
# `prisma migrate dev` with a relative DATABASE_URL resolves against the
# schema directory and creates prisma/prisma/dev.db. Never commit it.
backend/prisma/prisma/

# Environment files hold credentials. .env.example documents the shape instead.
.env
.env.*
!.env.example

# Generated from prisma/schema.prisma by `npm run schema:pg`
backend/prisma/postgres/schema.prisma

# Playwright artifacts
.playwright-mcp/

# Database dumps taken before a destructive operation. Real customer data and
# password hashes; never committed.
.backups/
