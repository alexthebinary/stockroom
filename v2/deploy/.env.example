# ProfitIndex on the Dell. ./start.sh copies this to .env (never commit it) on
# its first run, with a random database password; edit .env after that.

# Database password. Letters and digits only (it goes inside a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Leave empty for a temporary https://….trycloudflare.com address: no
# Cloudflare setup, but it changes whenever the Dell or the tunnel restarts
# (./url.sh prints the current one). For your own domain, paste your tunnel's
# token: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install
# connector", the long string after `--token`. Then `docker compose up -d`.
TUNNEL_TOKEN=

# Optional: pushes to your phone (new feedback, deploys) through ntfy. Install
# the ntfy app, subscribe to a topic name nobody would guess, and put it here:
#   NOTIFY_URL=https://ntfy.sh/profitindex-<something random>
NOTIFY_URL=

# Optional: Claude reads packing-slip photos when a box has no barcode.
ANTHROPIC_API_KEY=

# Optional: copy nightly backups to Cloudflare R2. Used once R2_ACCESS_KEY_ID is
# set; until then backups stay on this machine. (R2 → your bucket; R2 → Manage API tokens →
# "Object Read & Write", limited to that bucket).
R2_ACCOUNT_ID=
R2_BUCKET=profitindex-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: a healthchecks.io (or similar) ping URL. It gets a ping after every
# good backup and a /fail ping after a bad one, and emails you if they stop.
HEALTHCHECK_URL=

# How many nightly dumps to keep on the Dell itself (R2 keeps 90 days).
KEEP_LOCAL=14
