# Postgres 16. docker compose up -d db gives you this one.
DATABASE_URL=postgresql://profitindex:profitindex@localhost:5432/profitindex
# Tests use their own database and recreate its schema on every run.
TEST_DATABASE_URL=postgresql://profitindex:profitindex@localhost:5432/profitindex_test
PORT=4100
# Optional. Without it the packing-slip / label reader is hidden and
# barcodes plus manual entry still work.
ANTHROPIC_API_KEY=
